# Copy to .env and replace placeholders locally. Never commit real credentials.
# Backend signing key: use at least 32 random bytes in production.
SECRET_KEY=replace-with-at-least-32-random-bytes
# JSON mapping of configured users to password hashes and roles.
AUTH_USERS_JSON=replace-with-user-hash-map-json
# Absolute path to the workspace root permitted for local API operations.
WORKSPACE_ROOT=replace-with-absolute-workspace-path
# Local SQLite file path; keep the database outside public artifacts.
STATE_DB_PATH=replace-with-local-sqlite-path
# Optional remote Copilot settings. Default operation is evidence-only.
COPILOT_API_KEY=your-provider-api-key
COPILOT_BASE_URL=your-openai-compatible-provider-url
COPILOT_MODEL=your-provider-model
